PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/one_off_transfer
JWT_SECRET=change-this-to-a-long-random-string

# Public address of this server. Links shown to the owner are built from it.
# Phone/other device on your Wi-Fi: http://YOUR-LAPTOP-IP:3000
# Over the internet: your ngrok or deployed URL
BASE_URL=http://localhost:3000

# Only set these if the frontend is hosted somewhere else:
# FRONTEND_URL=https://my-frontend.example.com
# CORS_ORIGIN=https://my-frontend.example.com
